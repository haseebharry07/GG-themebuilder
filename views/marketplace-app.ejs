<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Theme Builder | GHL Marketplace</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#182230;background:#f4f6fa;font-synthesis:none}
    *{box-sizing:border-box}body{margin:0;padding:34px 18px}.wrap{max-width:980px;margin:auto}.header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:26px}.brand{font-size:14px;font-weight:700;letter-spacing:.12em;color:#6252d9;text-transform:uppercase}.header h1{margin:5px 0 0;font-size:30px;letter-spacing:-.04em}.account{border:1px solid #e3e6ee;background:#fff;border-radius:999px;padding:9px 14px;color:#526071;font-size:13px}.intro,.card{border:1px solid #e5e8ef;background:#fff;border-radius:16px;box-shadow:0 6px 24px #27304d0a}.intro{padding:23px 26px;margin-bottom:18px}.intro h2{margin:0 0 8px;font-size:19px}.intro p{margin:0;color:#667085;line-height:1.6}.card{padding:23px 26px;margin:16px 0}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.card h2{font-size:17px;margin:0 0 6px}.card p,.steps{color:#667085;line-height:1.6}.card p{font-size:13px;margin:0}.script{display:block;width:100%;min-height:94px;resize:vertical;border:1px solid #e0e4ec;border-radius:10px;background:#f8f9fc;padding:13px;color:#283448;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}.copy{flex:none;border:0;border-radius:9px;background:#6252d9;color:white;font-weight:650;padding:10px 15px;cursor:pointer}.copy:hover{background:#5040c4}.steps{padding-left:21px;font-size:14px}.steps li{padding:4px 0}.note{margin-top:16px;border-radius:10px;background:#f5f3ff;padding:13px 15px;color:#5040a9;font-size:13px;line-height:1.55}.error{border:1px solid #ffd6d6;background:#fff5f5;color:#9d2727;border-radius:12px;padding:16px 18px;line-height:1.6}.muted{color:#667085;font-size:13px}@media(max-width:600px){body{padding:20px 12px}.header{align-items:flex-start;flex-direction:column}.card{padding:18px}.header h1{font-size:25px}}
  </style>
</head>
<body>
<main class="wrap">
  <header class="header">
    <div><div class="brand">Theme Builder</div><h1>Your GHL setup</h1></div>
    <% if (!needsInstall && companyName) { %><div class="account"><%= companyName %></div><% } %>
  </header>

  <% if (error) { %>
    <div class="error"><%= error %></div>
    <% if (needsInstall) { %><p class="muted">After installing, return to GHL and open Theme Builder from the sidebar.</p><% } %>
  <% } else { %>
    <section class="intro">
      <h2>Your scripts are ready</h2>
      <p>Copy the CSS and JavaScript below into the Custom CSS and Custom JavaScript fields in your GHL account’s Whitelabel settings. Theme Builder will then apply your selected styling across your GHL interface.</p>
    </section>

    <section class="card">
      <div class="card-head"><div><h2>Custom CSS</h2><p>Paste this into the Whitelabel Custom CSS field.</p></div><button class="copy" type="button" data-copy="css">Copy CSS</button></div>
      <textarea class="script" id="css" readonly spellcheck="false"><%= customCss %></textarea>
    </section>

    <section class="card">
      <div class="card-head"><div><h2>Custom JavaScript</h2><p>Paste this into the Whitelabel Custom JavaScript field.</p></div><button class="copy" type="button" data-copy="js">Copy JavaScript</button></div>
      <textarea class="script" id="js" readonly spellcheck="false"><%= customJs %></textarea>
    </section>

    <section class="card">
      <h2>How to use Theme Builder</h2>
      <ol class="steps">
        <li>Copy the CSS and JavaScript snippets above.</li>
        <li>In GHL, open <strong>Settings → Company → Whitelabel</strong> (the exact menu label can vary by account).</li>
        <li>Paste each snippet into its matching Custom CSS or Custom JavaScript field, then save.</li>
        <li>Reload the GHL page. Open Theme Builder from the sidebar to customize the appearance.</li>
      </ol>
      <div class="note">These snippets are unique to your connected GHL account. Keep them in that account’s Whitelabel settings. You can return to this page from the Theme Builder sidebar item to copy them again.</div>
    </section>
  <% } %>
</main>
<script>
  document.querySelectorAll("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const text = document.getElementById(button.dataset.copy).value;
      try {
        await navigator.clipboard.writeText(text);
      } catch (_) {
        const field = document.getElementById(button.dataset.copy);
        field.focus(); field.select(); document.execCommand("copy");
      }
      const oldLabel = button.textContent;
      button.textContent = "Copied!";
      setTimeout(() => { button.textContent = oldLabel; }, 1400);
    });
  });
</script>
</body>
</html>
